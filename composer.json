{
    "name": "codifytech/asaas-sdk-laravel",
    "description": "SDK Laravel para a API Asaas v3: cliente HTTP com retry, serviços tipados, Models e validação de requisições.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": [
        "asaas",
        "laravel",
        "sdk",
        "pix",
        "boleto",
        "payments",
        "pagamentos",
        "api"
    ],
    "homepage": "https://github.com/CodifyTech/asaas-sdk-laravel",
    "support": {
        "issues": "https://github.com/CodifyTech/asaas-sdk-laravel/issues",
        "source": "https://github.com/CodifyTech/asaas-sdk-laravel",
        "security": "https://github.com/CodifyTech/asaas-sdk-laravel/security/policy"
    },
    "authors": [
        {
            "name": "CodifyTech",
            "homepage": "https://github.com/CodifyTech"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Asaas\\Laravel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Asaas\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asaas\\Laravel\\AsaasServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "generate": "php tools/generator/generate.php",
        "generate:check": "php tools/generator/generate.php --check --strict",
        "ci": [
            "@format:check",
            "@analyse",
            "@generate:check",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
